; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AVG Template"
config/version="1.0"
run/main_scene="res://DialogicFantasyMenu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://template_icon.svg"

[autoload]

ExampleBridge="*res://examples/integration/example_bridge.gd"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

settings/dialogue_font_size=38
settings/text_speed=1.0
directories/dch_directory={
"Alfonso": "res://examples/characters/Alfonso.dch",
"Astrid": "res://examples/characters/Characters/Astrid/Astrid.dch",
"EditorExample": "res://examples/characters/EditorExample.dch",
"Joska": "res://examples/characters/Characters/Joska/Joska.dch",
"Lilly": "res://examples/characters/Characters/Lilly/Lilly.dch",
"Lucas": "res://examples/characters/Characters/Lucas/Lucas.dch",
"Simone": "res://examples/characters/Simone.dch"
}
directories/dtl_directory={
"AudioExample": "res://examples/timelines/AudioExample.dtl",
"EndingLeft": "res://examples/timelines/EndingLeft.dtl",
"EndingRight": "res://examples/timelines/EndingRight.dtl",
"FrameworkExample": "res://examples/timelines/FrameworkExample.dtl",
"GalleryExample": "res://examples/timelines/GalleryExample.dtl",
"MusicSkye": "res://examples/timelines/MusicSkye.dtl",
"MusicTeller": "res://examples/timelines/MusicTeller.dtl",
"PongExample": "res://examples/timelines/PongExample.dtl",
"TestTimeline": "res://examples/timelines/TestTimeline.dtl"
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/join_default_wait=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autocolor_names=true
text/autopauses={}
glossary/default_case_sensitive=true
layout/style_list=["res://DialogicFantasyStyle/fantasy_style.tres"]
layout/default_style="res://DialogicFantasyStyle/fantasy_style.tres"
variables={
"PongResult": "",
"TextInput": ""
}
glossary/glossary_files=["res://examples/characters/test_glossary.tres"]
text/autoadvance_per_word_delay=0.4
text/autoadvance_fixed_delay=0.5
event_default_overrides={
"Music": {
"audio_bus": ""
},
"Sound": {
"audio_bus": ""
},
"Voice": {
"audio_bus": "Voice"
}
}
save/default_slot="slot_58"
save/autosave=true
save/autosave_mode=2
history/save_on_autosave=true
history/simple_history_enabled=true
history/visited_event_history_enabled=true
history/save_on_save=true
glossary/default_color=Color(0.179194, 0.226563, 0.0309753, 1)
layout/style_directory={
"": "res://DialogicFantasyStyle/fantasy_style.tres",
"fantasy_style": "res://DialogicFantasyStyle/fantasy_style.tres"
}
extensions_folder="res://addons/dialogic_additions"
animations/cross_fade_default_length=0.5
audio/channel_defaults={
"": {
"audio_bus": "SFX",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Music",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
portraits/default_portrait="res://addons/dialogic/Modules/HighlightPortrait/simple_highlight_portrait.tscn"
text/split_at_new_lines=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

